{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "test",
    "scripts",
    "packages",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
